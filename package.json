{
  "name": "macro-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Personal diet diary webapp on Cloudflare Pages Functions + D1.",
  "scripts": {
    "start": "wrangler pages dev",
    "db:migrate": "wrangler d1 migrations apply macro-tracker --local",
    "db:migrate:remote": "wrangler d1 migrations apply macro-tracker --remote",
    "deploy": "wrangler pages deploy"
  },
  "devDependencies": {
    "wrangler": "^4.151.1"
  }
}
